---
import { getCollection } from "astro:content";
import { siteTitle } from "../constants";

const allPosts = await getCollection("posts");
allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<div class="header-container">
  <nav>
    <div class="header-left">
      <a href="/" class="siteName">{siteTitle}</a>
      <ul role="list">
        <li><a href="/matteo" data-astro-prefetch="load">Matteo</a></li>
        <li><a href="/portfolio" data-astro-prefetch="load">Foto</a></li>
        <li>
          <!-- prefetch on every page view: warms the CDN cache (and
               triggers the stale-while-revalidate refresh) so the slow
               server render is done before anyone clicks -->
          <a href="/meteo-concenedo" data-astro-prefetch="load">Meteo</a>
        </li>
        <li><a href="/contatti" data-astro-prefetch="load">Contatti</a></li>
      </ul>
    </div>

    <form action="/cerca">
      <label for="search" class="visually-hidden">Cerca un’uscita</label>
      <input
        type="search"
        id="search"
        name="search"
        placeholder="es: Monte Rosa"
        required
        minlength="3"
      />
      <button type="submit" aria-label="Cerca" data-loading-label="Cerco...">
        Cerca
      </button>
    </form>
  </nav>
</div>
<script>
  // Hold the navigation while a fetch warms the CDN, then leave: with a
  // warm cache we navigate almost instantly, with a cold one we wait only
  // as long as the render actually takes (capped as a safety net)
  const MAX_WAIT_MS = 4000;

  const input = document.getElementById("search");
  const form = input instanceof HTMLInputElement ? input.form : null;
  const button = form?.querySelector("button");

  if (input instanceof HTMLInputElement && form && button) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      button.disabled = true;
      input.disabled = true;
      button.textContent = button.dataset.loadingLabel ?? "Cerco...";

      const url = new URL(form.action);
      url.searchParams.set("search", input.value);

      const warmup = fetch(url).catch(() => {});
      const cap = new Promise((resolve) => setTimeout(resolve, MAX_WAIT_MS));
      Promise.race([warmup, cap]).then(() => location.assign(url));
    });
  }

  // restore the form when navigating back via the bfcache
  window.addEventListener("pageshow", () => {
    const input = document.getElementById("search");
    if (!(input instanceof HTMLInputElement)) return;
    const button = input.form?.querySelector("button");
    if (!button) return;
    input.disabled = false;
    button.disabled = false;
    button.textContent = "Cerca";
  });
</script>
<style>
  .header-container {
    container-type: inline-size;
  }

  .header-left {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4rem;
    @container (width < 60rem) {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }

  nav {
    display: flex;
    justify-content: space-between;
    @container (width > 60rem) {
      flex-direction: row;
      align-items: center;
    }
    @container (width < 60rem) {
      flex-direction: column;
      gap: 1.5rem;
    }
  }

  .siteName {
    font-weight: 900;
    font-size: 1.25rem;
    margin: 0;
    text-transform: uppercase;
    text-decoration: none;
    display: block;
  }

  ul {
    font-size: 0.875rem;
    font-weight: 900;
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  li a {
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.5rem 0.5rem;
    margin-left: -0.5rem;
  }

  form {
    display: flex;
    flex-direction: row;
    gap: 0.5rem;
  }

  /* invisible copy of the loading label so the button is always as wide
     as its widest state and swapping the text causes no layout shift */
  form button::after {
    content: attr(data-loading-label);
    display: block;
    height: 0;
    visibility: hidden;
    overflow: hidden;
  }
</style>
