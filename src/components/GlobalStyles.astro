<style is:global>
  img {
    max-width: 100%;
    height: auto;
    background-color: color-mix(in oklab, currentColor 2%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    img {
      animation: img-placeholder-pulse 1s ease-in-out infinite alternate;
    }
  }

  @keyframes img-placeholder-pulse {
    from {
      background-color: color-mix(in oklab, currentColor 2%, transparent);
    }
    to {
      background-color: color-mix(in oklab, currentColor 8%, transparent);
    }
  }
  /* 11. variables */

  :root {
    color-scheme: light dark;
    --color-borders: color-mix(in oklab, currentColor 15%, transparent);
    --color-subtle: light-dark(
      color-mix(in oklab, currentColor, white 50%),
      color-mix(in oklab, currentColor, black 25%)
    );
    --color-accent: crimson;
    --color-graph-grid: color-mix(in oklab, currentColor 10%, transparent);
  }

  /* 12. base styles */

  html {
    font-family: var(--base-font); /** defined in astro config */
    font-size: 100%;
    line-height: 1.5;
    scrollbar-gutter: stable;
  }

  body {
    font-size: 1rem;
    line-height: 1.85;
  }

  a {
    color: inherit;
  }

  p {
    margin-bottom: 2rem;
  }

  a:hover {
    color: var(--color-subtle);
  }

  input,
  textarea,
  select {
    padding: 0.25rem 0.5rem;
    border-color: currentColor;
    border-width: 1px;
    border-style: solid;
  }

  h1,
  h2,
  h3 {
    font-weight: 900;
    line-height: 1.25;
  }

  h1 {
    font-size: 1.5rem;
    margin-top: 0rem;
    margin-bottom: 1.5rem;
  }

  h2,
  .h2 {
    margin-top: 0rem;
    margin-bottom: 0.85rem;
    font-size: 1rem;
  }

  figure {
    margin-bottom: 2rem;
  }

  figcaption,
  .caption {
    font-size: 0.85rem;
    color: var(--color-subtle);
  }

  figure figcaption {
    margin-top: 0.5rem;
  }

  button {
    appearance: none;
    background-color: Canvas; /* or Canvas */
    color: inherit;
    padding: 0.25rem 0.5rem;
    border: 1px solid currentColor;
    border-radius: 0;
  }

  summary {
    cursor: pointer;
    font-weight: 900;
  }

  details:open > summary {
    margin-bottom: 1rem;
  }

  dialog {
    border: 2px solid var(--color-subtle);
    overscroll-behavior: contain;
  }

  dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.85);
  }

  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1.5rem;
    margin: 0;
  }

  dt {
    grid-column: 1;
    font-weight: 900;
  }

  dd {
    grid-column: 2;
    margin: 0;
  }

  /* 13. utilities */

  .visually-hidden {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .hide-scrollbar {
    scrollbar-width: none;
  }
</style>
