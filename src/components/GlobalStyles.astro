<style is:global>
  /* 11. variables */

  :root {
    color-scheme: light dark;
    --color-bg: light-dark(#f8f9fa, #1e1e1e);
    --color-text: light-dark(#2c3e50, #cbd5e1);
    --color-subtle: light-dark(
      color-mix(in oklab, currentColor, white 25%),
      color-mix(in oklab, currentColor, black 25%)
    );
    --color-buttons: light-dark(#e9ecef, #2c2c2c);
    --color-input-bg: light-dark(#fff, #2c2c2c);
    --color-map-marker: red;
    --color-graph-grid: color-mix(in oklab, currentColor 10%, transparent);
    --color-graph-line: #1082e8;
    --color-weather-card-bg: light-dark(
      color-mix(in oklab, var(--color-bg), black 2.5%),
      color-mix(in oklab, var(--color-bg), black 10%)
    );
    --color-weather-graph-alt-line: orange;
    /* text colors: each variant keeps the hue and is tuned to ≥4.5:1 (WCAG
       AA) on both the page and the card background of its theme */
    --color-weather-min-value: light-dark(#0e6ec4, #1688ef);
    --color-weather-max-value: light-dark(#de0000, #ff3636);
    --color-weather-alt-value: light-dark(#c000c9, #f300ff);
    --color-weather-alt-value-2: light-dark(#097f14, #00ff00);
    --color-weather-pie-1: #36a2eb;
    --color-weather-pie-2: #ff6384;
    --color-weather-pie-3: #ff9f40;
    --color-weather-pie-4: #ffcd56;
    --color-weather-pie-5: #4bc0c0;
    --color-weather-pie-6: #9966ff;
    --color-weather-pie-7: #c9cbcf;
    --color-weather-pie-8: #7acbf9;
  }

  /* 12. base styles */

  @view-transition {
    navigation: auto;
  }

  html {
    font-family: var(--base-font); /** defined in astro config */
    font-size: 100%;
    line-height: 1.5;
    scrollbar-gutter: stable;
    color: var(--color-text);
    background-color: var(--color-bg);
  }

  body {
    font-size: 1rem;
    line-height: 1.85;
  }

  a {
    color: inherit;
  }

  :focus-visible {
    /* auto = the browser's native focus ring; !important so focus can
       never be suppressed by all:unset resets (e.g. Footer and
       PostGallery buttons), whose expanded outline:unset otherwise
       wins on specificity */
    outline: auto !important;
  }

  img {
    max-width: 100%;
    height: auto;
    background-color: color-mix(in oklab, currentColor 5%, currentColor 2%);
  }

  p {
    margin-bottom: 2rem;
  }

  a:hover {
    color: var(--color-subtle);
  }

  input,
  textarea,
  select {
    padding: 0.25rem 0.5rem;
    border-color: currentColor;
    border-width: 1px;
    border-style: solid;
    background-color: var(--color-input-bg);
  }

  h1,
  h2,
  h3 {
    font-weight: 800;
    line-height: 1.5;
  }

  /* the UA's "bolder" (700) barely stands out from 400 in JetBrains Mono,
     especially light-on-dark: use the font's heaviest weight, like headings */
  strong,
  b {
    font-weight: 800;
  }

  /* page titles share the h2 size; only posts set a bigger one, since there
     the title is the content */
  h1 {
    font-size: 1.125rem;
    margin-top: 0rem;
    margin-bottom: 2rem;
  }

  @media (orientation: portrait) {
    h1 {
      margin-bottom: 1.5rem;
    }
  }

  h2,
  .h2 {
    margin-top: 0rem;
    margin-bottom: 1rem;
    font-size: 1.125rem;
  }

  h3 {
    margin-top: 0rem;
    font-size: 1rem;
  }

  figure {
    margin-bottom: 2rem;
  }

  figcaption,
  .caption {
    font-size: 0.85rem;
    /* small text doesn't need the body's 1.85 */
    line-height: 1.5;
    color: var(--color-subtle);
  }

  figure figcaption {
    margin-top: 0.5rem;
  }

  button {
    appearance: none;
    background-color: var(--color-buttons);
    color: inherit;
    padding: 0.25rem 0.85rem;
    border: 1px solid currentColor;
    border-radius: 0;
    font-weight: 700;
  }

  button:disabled {
    background-color: color-mix(in oklab, currentColor 15%, transparent);
    border-color: color-mix(in oklab, currentColor 15%, transparent);
    cursor: not-allowed;
  }

  button:active {
    transform: translate(1px, 1px);
  }

  summary {
    cursor: pointer;
    font-weight: 800;
  }

  details:open > summary {
    margin-bottom: 1rem;
  }

  dialog {
    border: 2px solid var(--color-subtle);
    overscroll-behavior: contain;
    /* the UA default is Canvas, which is browser-specific */
    background-color: var(--color-bg);
  }

  dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.85);
  }

  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.25rem 1.5rem;
    margin: 0;
  }

  dt {
    grid-column: 1;
    font-weight: 800;
  }

  dd {
    grid-column: 2;
    margin: 0;
  }

  label {
    display: block;
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  /* 13. utilities */

  /* the hidden attribute hides via the UA stylesheet, which any author
     display (e.g. .theme-toggle's flex) silently overrides — make it
     unconditional */
  [hidden] {
    display: none !important;
  }

  /* Masonry grid for photos. Baseline is multi-column (works everywhere,
     items flow down each column); where the browser supports native
     masonry (display: grid-lanes) items flow left-to-right instead.
     Vertical spacing is a padding on the items, compensated by the
     container's negative margin: margins at column ends get truncated
     differently across browsers, padding doesn't.
     Tune per use with --masonry-min (column min width) and --masonry-gap. */
  .masonry {
    --masonry-min: 16rem;
    --masonry-gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 calc(var(--masonry-gap) * -1);
    columns: var(--masonry-min);
    column-gap: var(--masonry-gap);
  }

  .masonry > * {
    break-inside: avoid;
    padding-bottom: var(--masonry-gap);
  }

  @supports (display: grid-lanes) {
    .masonry {
      display: grid-lanes;
      grid-template-columns: repeat(
        auto-fill,
        minmax(min(100%, var(--masonry-min)), 1fr)
      );
      gap: var(--masonry-gap);
      columns: auto;
      margin-bottom: 0;
    }

    .masonry > * {
      padding-bottom: 0;
    }
  }

  .visually-hidden {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .hide-scrollbar {
    scrollbar-width: none;
  }

  .skip-link {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    background-color: var(--color-bg);
  }

  .skip-link:not(:focus) {
    /* same recipe as .visually-hidden until keyboard-focused */
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    width: 1px;
    overflow: hidden;
    white-space: nowrap;
  }
</style>
