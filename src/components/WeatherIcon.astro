---
// Meteocons (MIT — https://bas.dev/work/meteocons) embedded as data-URI
// <img>s: still zero HTTP requests, but each icon is its own SVG document.
// That matters for the SMIL animations: an inline <svg>'s animation clock
// stays frozen at 0 until the whole page fires `load`, so on a slow load the
// icons sat still and then started with a jerk. An SVG image runs its own
// clock from the moment it's decoded. Separate documents also mean the
// files' colliding id="a" gradients no longer need namespacing.
import { WEATHER_ICON_FILES } from "../lib/weatherIcons";

const files = import.meta.glob("../assets/weather-icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const { icon, isDay = true, size = 64, label } = Astro.props;
const name = (WEATHER_ICON_FILES[icon] ?? WEATHER_ICON_FILES.cloudy)[
  isDay ? 0 : 1
];

const svg = files[`../assets/weather-icons/${name}.svg`];
const src = `data:image/svg+xml,${encodeURIComponent(svg)}`;
---

<img
  src={src}
  width={size}
  height={size}
  alt={label ?? ""}
  decoding="sync"
  class="weather-icon"
/>

<style>
  /* no loading placeholder (global img rule): the icon is decoded inline
     and has a transparent background */
  .weather-icon {
    background: none;
  }
</style>
