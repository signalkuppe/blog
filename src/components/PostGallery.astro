---
import { Image } from "astro:assets";
import GalleryModal from "./GalleryModal.astro";

interface Props {
  gallery: {
    src: ImageMetadata;
    alt: string;
  }[];
}

const { gallery } = Astro.props;
---

<div class="gallery">
  {
    gallery.map((image, index) => (
      <Fragment>
        <button
          type="button"
          command="show-modal"
          commandfor={`gallery-image-${index}`}
          class="open-modal-button"
        >
          <span class="visually-hidden">Apri immagine</span>
          <Image
            src={image.src}
            alt={image.alt}
            width={160}
            height={160}
            loading="lazy"
            quality={75}
            class="gallery-image"
          />
        </button>
        <GalleryModal index={index} count={gallery.length} image={image} />
      </Fragment>
    ))
  }
</div>

<style>
  .gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .gallery-image {
    width: 80px;
    height: 80px;
    object-fit: cover;
  }

  @media (orientation: portrait) {
    .gallery-image {
      width: 67px;
      height: 70px;
    }
  }

  .gallery .open-modal-button {
    all: unset;
    cursor: pointer;
  }
</style>
