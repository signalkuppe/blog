---
import { Image } from "astro:assets";
import GalleryModal from "./GalleryModal.astro";

interface Props {
  gallery: {
    src: ImageMetadata;
    alt: string;
  }[];
}

const { gallery } = Astro.props;
---

<ul class="gallery masonry" role="list">
  {
    gallery.map((image, index) => (
      <li>
        <button
          type="button"
          command="show-modal"
          commandfor={`gallery-image-${index}`}
          class="open-modal-button"
        >
          <span class="visually-hidden">Apri immagine</span>
          <Image
            src={image.src}
            alt={image.alt}
            width={400}
            loading="lazy"
            quality={75}
            class="gallery-image"
          />
        </button>
        <GalleryModal index={index} count={gallery.length} image={image} />
      </li>
    ))
  }
</ul>

<style>
  /* 5 columns in the 40rem text column, 3 on a phone */
  .gallery {
    --masonry-min: 6.25rem;
    --masonry-gap: 0.75rem;
  }

  .gallery .open-modal-button {
    all: unset;
    cursor: pointer;
    display: block;
    width: 100%;
  }

  .gallery-image {
    display: block;
    width: 100%;
    height: auto;
  }
</style>
