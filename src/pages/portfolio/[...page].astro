---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { headPageTitle } from "../../lib/utils";
import { siteSlogan, defaultOgImage } from "../../constants";
import Layout from "../../layouts/Layout.astro";
import Pager from "../../components/Pager.astro";
import GalleryModal from "../../components/GalleryModal.astro";

export async function getStaticPaths({ paginate }) {
  const photos = await getCollection("portfolio");
  const getFolderNumber = (entry) =>
    Number.parseInt(entry.id.split("/")[0], 10);
  photos.sort((a, b) => {
    const aFolder = getFolderNumber(a);
    const bFolder = getFolderNumber(b);
    if (Number.isFinite(aFolder) && Number.isFinite(bFolder)) {
      return bFolder - aFolder;
    }
    return b.data.date.getTime() - a.data.date.getTime();
  });

  return paginate(photos, {
    pageSize: 12,
  });
}

interface Props {
  page?: any;
}

const { page } = Astro.props;

let pageTitle = "Le mie foto";

if (page.currentPage > 1) {
  pageTitle = `${pageTitle}, pagina ${page.currentPage}`;
}

const description = "Una raccolta delle mie foto più belle";

// Le anteprime crescono con lo schermo (vedi --photo-min nel CSS): serve una
// variante più grande per gli schermi larghi/retina, senza mai superare
// la larghezza dell'originale.
const thumbWidths = [800, 1200];
const thumbSizes =
  "(min-width: 2560px) 480px, (min-width: 1160px) 25vw, (min-width: 880px) 33vw, (min-width: 600px) 50vw, 100vw";
---

<Layout
  title={headPageTitle(pageTitle, siteSlogan)}
  description={description}
  ogImage={defaultOgImage}
>
  <h1 class="h2">{pageTitle}</h1>

  <ul class="photos">
    {
      page.data.map((photo, index) => (
        <li>
          <button
            type="button"
            command="show-modal"
            commandfor={`gallery-image-${index}`}
            class="open-modal-button"
          >
            <span class="visually-hidden">Apri {photo.data.title}</span>
            <Image
              src={photo.data.photo.src}
              alt={photo.data.photo.alt}
              width={800}
              widths={thumbWidths.filter(
                (width) => width <= photo.data.photo.src.width,
              )}
              sizes={thumbSizes}
              quality={80}
              loading={index === 0 ? "eager" : "lazy"}
              class="photo"
            />
          </button>
          <GalleryModal
            index={index}
            count={page.data.length}
            image={photo.data.photo}
            caption={photo.data.title}
          />
        </li>
      ))
    }
  </ul>

  <div class="pager">
    <Pager page={page} />
  </div>
</Layout>

<style>
  h1 {
    margin-bottom: 2rem;
  }

  ul.photos {
    list-style: none;
    padding: 0;
    /* Masonry via multi-column: funziona ovunque, ma l'ordine scorre
       dall'alto in basso colonna per colonna. Lo spazio verticale è un
       padding (i margini a fine colonna vengono troncati in modo diverso
       tra browser) e il margine negativo compensa quello dell'ultima foto. */
    margin: 0 0 calc(var(--photos-gap) * -1);
    --photos-gap: 1.5rem;
    /* larghezza minima di una colonna: cresce con lo schermo, così le
       anteprime si ingrandiscono invece di moltiplicare le colonne */
    --photo-min: clamp(16rem, 20vw, 30rem);
    columns: var(--photo-min);
    column-gap: var(--photos-gap);
  }

  /* Oltre la larghezza del contenitore (1024px + padding) la griglia esce
     dal contenitore e occupa tutta la pagina; il titolo resta
     allineato all'header. Il margine laterale assorbe anche l'eventuale
     scrollbar, che 100vw include. */
  @media (min-width: 1088px) {
    ul.photos {
      --photos-gutter: 2rem;
      margin-inline: calc(50% - 50vw + var(--photos-gutter));
    }
  }

  ul.photos li {
    break-inside: avoid;
    padding-bottom: var(--photos-gap);
  }

  /* Masonry nativo dove supportato: mantiene l'ordine da sinistra a destra */
  @supports (display: grid-lanes) {
    ul.photos {
      display: grid-lanes;
      grid-template-columns: repeat(
        auto-fill,
        minmax(min(100%, var(--photo-min)), 1fr)
      );
      gap: var(--photos-gap);
      columns: auto;
      margin-bottom: 0;
    }

    ul.photos li {
      padding-bottom: 0;
    }
  }

  .open-modal-button {
    all: unset;
    cursor: pointer;
    display: block;
    width: 100%;
  }

  .photo {
    display: block;
    width: 100%;
    height: auto;
    will-change: transform;
  }

  .photo:hover {
    transform: scale(1.02);
    transition: transform 0.2s ease-in-out;
  }

  .pager {
    margin-top: 4rem;
  }

  /* con la griglia a tutta pagina (stesso breakpoint di ul.photos) il pager
     si centra sotto le foto, con più respiro */
  @media (min-width: 1088px) {
    .pager {
      display: flex;
      justify-content: center;
      margin-top: 6rem;
    }
  }
</style>
