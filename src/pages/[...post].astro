---
import { getImage } from "astro:assets";
import { getCollection, render } from "astro:content";
import { headPageTitle } from "../lib/utils";
import { siteTitle, categories, newsletterUrl } from "../constants";
import Layout from "../layouts/Layout.astro";
import PostGallery from "../components/PostGallery.astro";
import PostGpx from "../components/PostGpx.astro";
import PostImage from "../components/PostImage.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  const pages = posts.map((post, i) => ({
    params: { post: post.id },
    props: {
      post,
      prev: posts[i - 1],
      next: posts[i + 1],
    },
  }));
  return pages;
}

interface Props {
  post: any;
  prev: any;
  next: any;
}

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const postGpxTrack = post.data.gpxTracks?.[0];
const postSlug = post.id;
const prevSlug = prev ? prev.id : "";
const nextSlug = next ? next.id : "";

// same short format as the home listing (PostCard): 09/11/26
const pagerDate = (date: Date) =>
  date.toLocaleDateString("it-IT", {
    day: "2-digit",
    month: "2-digit",
    year: "2-digit",
  });
const hasGallery = post.data.gallery && post.data.gallery.length > 0;

const postCategory = categories.find((c) => c.title === post.data.category[0]);

const ogImg = await getImage({
  src: post.data.cover.src,
  width: 1200,
  format: "jpg",
  quality: 75,
});
---

<Layout
  title={headPageTitle(post.data.title, siteTitle)}
  description={post.data.description}
  ogImage={ogImg.src}
  ogType="article"
>
  <article>
    <nav class="breadcrumb" aria-label="Percorso di navigazione">
      <ol class="hide-scrollbar" role="list">
        <li><a href="/">Home</a></li>
        {
          postCategory && (
            <li>
              <a href={`/${postCategory.slug}/`}>{postCategory.title}</a>
            </li>
          )
        }
        <li aria-current="page" class="visually-hidden">{post.data.title}</li>
      </ol>
    </nav>
    <time datetime={post.data.date.toISOString()}>
      {
        post.data.date.toLocaleDateString("it-IT", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })
      }
    </time>
    <h1>{post.data.title}</h1>
    {
      post.data.description && (
        <p class="post-description">{post.data.description}</p>
      )
    }
    <!-- rendered through PostImage so it's counted as the page's first image:
         it loads eagerly as the LCP and the body images fall back to lazy -->
    <div class="post-cover">
      <PostImage src={post.data.cover.src} alt={post.data.cover.alt} />
    </div>
    <Content />
    <aside class="post-aside">
      {
        hasGallery && (
          <details>
            <summary>Galleria fotografica</summary>
            <PostGallery gallery={post.data.gallery} />
          </details>
        )
      }
      {
        postGpxTrack && (
          <details>
            <summary>Mappa e Traccia GPS</summary>
            <PostGpx
              track={postGpxTrack}
              title={post.data.title}
              minimumAltitude={post.data.minimumAltitude}
              maximumAltitude={post.data.maximumAltitude}
              elevationGain={post.data.elevationGain}
              distance={post.data.distance}
            />
          </details>
        )
      }

      <nav class="post-pager">
        <ul role="list">
          {/* posts are sorted newest first: `next` is the older outing */}
          {
            next && (
              <li class="older">
                <a href={`/${nextSlug}/`}>
                  <span class="pager-label">
                    Uscita precedente
                  </span>
                  <span class="pager-title">{next.data.title}</span>
                  <time datetime={next.data.date.toISOString()}>
                    {pagerDate(next.data.date)}
                  </time>
                </a>
              </li>
            )
          }
          {
            prev && (
              <li class="newer">
                <a href={`/${prevSlug}/`}>
                  <span class="pager-label">
                    Uscita successiva
                  </span>
                  <span class="pager-title">{prev.data.title}</span>
                  <time datetime={prev.data.date.toISOString()}>
                    {pagerDate(prev.data.date)}
                  </time>
                </a>
              </li>
            )
          }
        </ul>
      </nav>
    </aside>
    <footer class="post-footer">
      <div class="disclaimer">
        <strong>Disclaimer</strong>
        <p>
          La rilevazione gps potrebbe non essere sempre precisa e riportare
          valori errati. Le attività in montagna sono pericolose, informati bene
          prima di affrontarle e non fare affidamento solo sui dati riportati in
          questa pagina. Non mi assumo alcuna responsabilità per eventuali
          incidenti o problemi che potrebbero verificarsi durante una delle
          attività descritte in questo blog.
        </p>
      </div>
      <p class="post-newsletter">
        Vuoi rimanere aggiornato sulle nuove uscite? <br /><a
          href={newsletterUrl}>Iscriviti alla newsletter</a
        >
      </p>
    </footer>
  </article>

  <style>
    .breadcrumb {
      font-size: 0.85rem;
      margin-bottom: 3rem;
    }

    .breadcrumb ol {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      list-style: none;
      margin: 0;
      padding: 0;
      max-width: 40rem;
      overflow: auto;
    }

    .breadcrumb li {
      display: flex;
      align-items: center;
      flex-shrink: 0;
      gap: 0.5rem;
      min-width: 0;
    }

    .breadcrumb li + li::before {
      content: "›";
      color: var(--color-subtle);
    }

    @media (orientation: portrait) {
      .breadcrumb {
        margin-bottom: 2rem;
      }
    }

    /* 40rem ≈ 67 monospace characters per line */
    article {
      max-width: 40rem;
    }

    .breadcrumb {
      color: var(--color-subtle);
    }

    time {
      display: block;
      margin-bottom: 0.5rem;
      font-size: 0.85rem;
      color: var(--color-subtle);
    }

    h1 {
      font-size: 1.625rem;
      line-height: 1.4;
      margin-bottom: 1rem;
    }

    .post-description {
      font-size: 1rem;
      line-height: 1.6;
      color: var(--color-subtle);
      margin-top: 0;
      margin-bottom: 2rem;
    }

    .post-cover {
      margin-top: 2rem;
    }

    /* body typography: paragraphs sit closer together, headings carry their
       own space above, so sections read as blocks */
    article :global(p) {
      margin-bottom: 1.5rem;
    }

    article :global(h2) {
      font-size: 1.125rem;
      margin-top: 3rem;
      margin-bottom: 1rem;
    }

    article :global(figure) {
      margin-bottom: 2rem;
    }

    article .post-aside {
      margin-top: 6rem;
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }

    /* the appendices (gallery, GPS) read as sections, not as UI widgets */
    .post-aside summary {
      font-size: 1.125rem;
      line-height: 1.5;
    }

    @media (orientation: portrait) {
      article {
        /* monospace at 16px gives only ~34 characters per line on a phone */
        font-size: 0.9375rem;
      }

      h1 {
        font-size: 1.375rem;
      }

      article .post-aside {
        margin-top: 4rem;
        gap: 3rem;
      }
    }

    .disclaimer {
      color: var(--color-subtle);
      font-size: 0.85rem;
      line-height: 1.5;
    }

    .post-newsletter {
      font-size: 0.85rem;
    }

    /* navigation, not another appendix: sits further from the details
       (aside gap + this = 4rem) */
    .post-pager {
      margin-top: 1rem;
    }

    .post-pager ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      gap: 2rem;
    }

    .post-pager li {
      flex: 1 1 0;
      min-width: 0;
    }

    @media (orientation: portrait) {
      .post-pager ul {
        flex-direction: column;
        gap: 1rem;
      }
    }

    /* the newer outing sits on the right even when it's the only one */
    .post-pager .newer {
      margin-left: auto;
      text-align: right;
    }

    .post-pager a {
      display: block;
      text-decoration: none;
    }

    .post-pager .pager-label,
    .post-pager time {
      display: block;
      margin: 0;
      font-size: 0.85rem;
      line-height: 1.5;
      color: var(--color-subtle);
    }

    .post-pager .pager-title {
      display: block;
      margin: 0.25rem 0;
      font-weight: 800;
      line-height: 1.4;
    }

    .post-pager a:hover .pager-title {
      text-decoration: underline;
    }

    @media (orientation: portrait) {
      .post-pager .newer {
        margin-left: 0;
        text-align: left;
      }
    }

    .post-footer {
      margin-top: 4rem;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
  </style>
</Layout>
