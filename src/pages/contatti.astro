---
import { siteTitle } from "../constants";
import Layout from "../layouts/Layout.astro";
---

<Layout title={`Contatti - ${siteTitle}`} description="Contatta Matteo Leoni">
  <h1>Contatti</h1>

  <form
    action="/grazie"
    name="contact"
    method="POST"
    autocomplete="off"
    data-netlify="true"
    netlify-honeypot="bot-field"
  >
    <label class="visually-hidden">
      Non compilarlo se sei umano: <input name="bot-field" />
    </label>

    <div>
      <label for="email">Email</label>
      <input
        id="email"
        required
        name="email"
        type="email"
        autocapitalize="off"
        placeholder="es: info@miaemail.it"
      />
    </div>
    <div>
      <label for="message">Messaggio</label>
      <textarea
        required
        id="message"
        name="message"
        spellcheck="false"
        autocorrect="off"
        autocomplete="off"
        autocapitalize="off"
        rows="5"
        cols="50"></textarea>
    </div>
    <div>
      <label>
        <input type="checkbox" required name="policy" />
        Ho letto la <a href="/privacy">la privacy policy</a>
      </label>
    </div>
    <button type="submit" class="btn">Invia il messaggio</button>
  </form>
</Layout>

<style>
  form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    max-width: 40rem;
  }

  form > div {
    width: 100%;
  }

  input[type="email"],
  textarea {
    width: 100%;
  }

  /* rows/cols are only fallback hints; CSS owns the width, and vertical-only
     resize keeps the textarea from being dragged out of the layout */
  textarea {
    resize: vertical;
  }
</style>
